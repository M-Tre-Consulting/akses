<Application
    x:Class="Akses.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Akses accent (coral, same as the icon and the site page): accent buttons, toggles,
                 progress bars and selection use it instead of the Windows accent colour. -->
            <Color x:Key="SystemAccentColor">#FF6A3D</Color>
            <Color x:Key="SystemAccentColorLight1">#FF8560</Color>
            <Color x:Key="SystemAccentColorLight2">#FFA183</Color>
            <Color x:Key="SystemAccentColorLight3">#FFBEA8</Color>
            <Color x:Key="SystemAccentColorDark1">#E04F23</Color>
            <Color x:Key="SystemAccentColorDark2">#BC3F18</Color>
            <Color x:Key="SystemAccentColorDark3">#962F10</Color>
        </ResourceDictionary>
    </Application.Resources>
</Application>
