[Desktop Entry]
Type=Application
Name=Akses
GenericName=File converter
GenericName[it]=Convertitore di file
GenericName[es]=Conversor de archivos
GenericName[fr]=Convertisseur de fichiers
GenericName[de]=Dateikonverter
Comment=Give it a file: it shows everything you can do with it
Comment[it]=Dagli un file: ti mostra tutto quello che puoi farci
Comment[es]=Dale un archivo: te muestra todo lo que puedes hacer con él
Comment[fr]=Donnez-lui un fichier : il vous montre tout ce que vous pouvez en faire
Comment[de]=Gib ihm eine Datei: Es zeigt dir alles, was du damit machen kannst
Exec=akses %F
Icon=akses
Terminal=false
StartupNotify=true
StartupWMClass=akses
Categories=Graphics;AudioVideo;Utility;
Keywords=convert;converter;mkv;mp4;webp;jpg;heic;pdf;trim;crop;resize;video;audio;image;
